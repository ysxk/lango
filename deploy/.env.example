# Copy to deploy/.env. Never commit real credentials.
# Generate separate values with: python3 -c 'import secrets; print(secrets.token_hex(32))'
POSTGRES_PASSWORD=
LANGO_JWT_SECRET=
LANGO_GOOGLE_API_KEY=

# development permits trusted LAN HTTP. Public deployments must use production + HTTPS.
LANGO_ENVIRONMENT=development
BIND_ADDRESS=127.0.0.1
PORT=8000
LANGO_ALLOWED_ORIGINS=[]
PUBLIC_DOMAIN=

LANGO_TEXT_MODEL=gemini-3.8-flash
LANGO_TTS_MODEL=gemini-3.8-flash-lite-tts
LANGO_LIVE_MODEL=gemini-3.8-live
LANGO_EMBEDDING_MODEL=gemini-embedding-001
LANGO_DEFAULT_ENGINE=cascade
LANGO_DAILY_MINUTES=60
